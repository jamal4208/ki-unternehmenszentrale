# Airtable Pilot-Konfiguration fuer lokale Tests.
# AIRTABLE_PAT niemals in Frontend-Dateien eintragen.
# Echte Werte spaeter nur lokal in .env.local eintragen.
# .env.local darf nicht gesichert oder committed werden.
# AIRTABLE_ENABLE_CONNECTION_TEST bleibt standardmaessig false.
# V6.1.0: Airtable-Test-Base ist nur fuer Testdaten.
# Echte Werte nur in .env.local eintragen.
# .env.local niemals sichern oder committen.
# Connection-Test ist read-only.
# Keine Record-Felder werden ausgegeben.

# V7.2 Phase A Schritt 1: optionales Override des Datenverzeichnisses fuer
# die Auth-Datenbank (auth-db.js). Ohne Angabe wird der Standardpfad
# ~/Library/Application Support/KI-Unternehmenszentrale/auth/auth.sqlite
# verwendet. Nur lokal setzen, niemals einen produktiven Pfad committen.
KUZ_DATA_DIR=

# V7.2 Phase A Schritt 2: Betriebsmodus der Zugriffsgrenze.
# "dev" (Standard, wenn nicht gesetzt) erlaubt lokal auf Loopback weiterhin
# den bestehenden Chef-Modus ohne Owner-Login (siehe Konsolenwarnung beim
# Start). "prod" erzwingt Owner-Login fuer alle internen Routen, deaktiviert
# Execution-Routen vollstaendig und verlangt zusaetzlich KUZ_PUBLIC_ORIGIN.
# Niemals in Produktivbetrieb auf "dev" belassen.
KUZ_MODE=dev

# V7.2 Phase A Schritt 2: nur im Produktivmodus (KUZ_MODE=prod) zwingend
# erforderlich. Exakte, ausschliesslich erlaubte Origin (Schema+Host[:Port])
# fuer die Origin-/Referer-Pruefung unsicherer Requests. Fehlt dieser Wert im
# Produktivmodus, bricht der Serverstart kontrolliert ab (fail-closed).
KUZ_PUBLIC_ORIGIN=

PORT=4173
AIRTABLE_API_KEY=
AIRTABLE_API_TOKEN=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_PROJECTS=
AIRTABLE_ENABLE_CONNECTION_TEST=false
AIRTABLE_FIRST_PREVIEW_TABLE_ID=
AIRTABLE_FIRST_READONLY_PREVIEW_APPROVED=false

# Nur lokal auf true setzen, wenn Jamal die erste read-only Minimalanzeige manuell freigibt.
